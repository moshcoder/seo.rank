{
  "name": "seorank",
  "version": "0.2.1",
  "description": "seo.rank: a free, open-source on-page SEO audit. Web app, JSON API, CLI, TUI and an MCP server (stdio, no API key).",
  "license": "MIT",
  "type": "module",
  "homepage": "https://seo.rank",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshcoder/seo.rank.git"
  },
  "bin": {
    "seorank": "bin/seorank"
  },
  "files": [
    "bin/seorank",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@profullstack/hqtui": "^0.10.3",
    "hono": "^4.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "seo",
    "seo audit",
    "on-page seo",
    "technical seo",
    "mcp",
    "mcp server",
    "model context protocol",
    "cli",
    "tui",
    "moshpit"
  ]
}
